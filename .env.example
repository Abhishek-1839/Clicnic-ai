# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
# "anon" key (or the newer "publishable" key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key (or the newer "secret" key). SERVER ONLY - never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

Shivvatika#123

# --- AI providers (used from phase 2) ---
XAI_API_KEY=
GEMINI_API_KEY=

# --- Demo mode ---
# Shows the demo staff credentials on the login page. All data is synthetic.
NEXT_PUBLIC_DEMO_MODE=true
# Password given to the seeded demo accounts
DEMO_PASSWORD=Demo@12345
NEXT_PUBLIC_DEMO_PASSWORD=Demo@12345
