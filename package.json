{
  "name": "clinic-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/safety/safety.test.ts src/lib/ai/fallback.test.ts src/lib/ai/llm.test.ts src/lib/ai/analyze.test.ts src/lib/booking/slots.test.ts src/lib/booking/engine.test.ts src/lib/dashboard/transitions.test.ts src/lib/ratelimit.test.ts",
    "ai:smoke": "tsx --env-file=.env.local scripts/ai-smoke.ts",
    "seed": "tsx --env-file=.env.local scripts/seed.ts",
    "seed:reset": "tsx --env-file=.env.local scripts/seed.ts --reset",
    "add-clinic": "tsx --env-file=.env.local scripts/add-clinic.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.50.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
